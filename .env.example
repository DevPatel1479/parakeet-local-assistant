# Local Ollama server and model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b-instruct

# faster-whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=4

# Optional: full path to a Python executable if Python is not on PATH.
# PARAKEET_PYTHON=C:\\path\\to\\project\\.venv\\Scripts\\python.exe
